# App
APP_NAME=Asistente de Propiedad Horizontal
APP_VERSION=0.1.0-mvp
DEBUG=true

# Database (PostgreSQL for prod, SQLite for dev)
DATABASE_URL=postgresql://aph_user:aph_pass@localhost:5432/aph_db
DATABASE_URL_SQLITE=sqlite:///./aph_dev.db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-this-in-production-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@aph.com

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
RATE_LIMIT_PER_MINUTE=60
